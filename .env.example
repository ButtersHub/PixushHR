# Copy to .env (git-ignored) and fill in real values. Compose feeds these to the engine.
# Langfuse tracing — keys from Langfuse UI > Settings > API Keys. Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU cloud; US = https://us.cloud.langfuse.com; or self-hosted URL
LANGFUSE_HOST=https://cloud.langfuse.com
